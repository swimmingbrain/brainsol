        <mxCell id="p3-planer" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;Planer&lt;/b&gt;&lt;/span&gt;&lt;br&gt;alle 3 Stunden für&lt;br&gt;jede Stunde des&lt;br&gt;restlichen Tages' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#e9f6ec;strokeColor=#1e7b34;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p3-1">
