        <mxCell id="p3-filt" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;Schutz&lt;/b&gt;&lt;/span&gt;&lt;br&gt;nur Stellungen ohne Stress' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#e9f6ec;strokeColor=#1e7b34;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p3-1">
