        <mxCell id="p4-title" value='&lt;span style="font-size: 21px;"&gt;&lt;b&gt;Ein Tag: was wann passiert&lt;/b&gt;&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="p4-1">
