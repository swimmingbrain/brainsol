        <mxCell id="p3-d3" value="Braucht das Lichtziel&lt;br&gt;diese Stunde?" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#e9f6ec;strokeColor=#1e7b34;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="p3-1">
