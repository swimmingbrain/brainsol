        </mxCell>
        <mxCell id="p3-o1" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;zur Sonne&lt;/b&gt;&lt;/span&gt;&lt;br&gt;der meiste Strom' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#fdeeec;strokeColor=#b42318;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p3-1">
          <mxGeometry x="950" y="95" width="280" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="p3-o2" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;wenig Licht&lt;/b&gt;&lt;/span&gt;&lt;br&gt;Stellung mit dem wenigsten&lt;br&gt;Licht an der Pflanze' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#fdeeec;strokeColor=#b42318;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p3-1">
          <mxGeometry x="950" y="225" width="280" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="p3-o3" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;wegdrehen&lt;/b&gt;&lt;/span&gt;&lt;br&gt;so weit, wie das Lichtziel&lt;br&gt;es braucht (Pflicht)' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#fdeeec;strokeColor=#b42318;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p3-1">
          <mxGeometry x="950" y="470" width="280" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="p3-o4" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;wegdrehen&lt;/b&gt;&lt;/span&gt;&lt;br&gt;weniger Strom, mehr Erlös' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#fdeeec;strokeColor=#b42318;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p3-1">
          <mxGeometry x="950" y="610" width="280" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="p3-o5" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;zur Sonne&lt;/b&gt;&lt;/span&gt;&lt;br&gt;der meiste Erlös' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#fdeeec;strokeColor=#b42318;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p3-1">
          <mxGeometry x="640" y="735" width="200" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="p3-note" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;Welche Stunden das Licht bekommen&lt;/b&gt;&lt;/span&gt;&lt;br&gt;die, in denen ein mol Licht am wenigsten&lt;br&gt;Erlös kostet. Stunden unter 0 zuerst, dort&lt;br&gt;bringt Wegdrehen sogar Geld. Schafft der Tag&lt;br&gt;das Ziel nicht, bekommt die Pflanze jede&lt;br&gt;Stunde das meiste Licht.' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#e9f6ec;strokeColor=#1e7b34;strokeWidth=1.8;align=left;spacingLeft=8;verticalAlign=middle;spacing=4;" vertex="1" parent="p3-1">
          <mxGeometry x="30" y="470" width="510" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="p3-mtitle" value='&lt;span style="font-size: 17px;"&gt;&lt;b&gt;Wie das Geld entsteht&lt;/b&gt;&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="p3-1">
          <mxGeometry x="30" y="845" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p3-mod" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;Modul&lt;/b&gt;&lt;/span&gt;&lt;br&gt;macht Strom, je nach&lt;br&gt;Stellung mehr oder weniger' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#fdeeec;strokeColor=#b42318;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p3-1">
