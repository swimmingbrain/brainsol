        </mxCell>
        <mxCell id="p3-strom" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;Strom&lt;/b&gt;&lt;/span&gt;&lt;br&gt;kWh in jeder Stunde' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#eaf2fb;strokeColor=#1a5fb4;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p3-1">
