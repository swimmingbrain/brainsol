        <mxCell id="p4-eve" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;Am Vorabend&lt;/b&gt;&lt;/span&gt;&lt;br&gt;bekannt: Börsenpreise&lt;br&gt;für jede Stunde und die&lt;br&gt;Vorhersage des Wetterdienstes' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#eaf2fb;strokeColor=#1a5fb4;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p4-1">
