        <mxCell id="p3-i3" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;Vorhersage&lt;/b&gt;&lt;/span&gt;&lt;br&gt;Licht und Temperatur für&lt;br&gt;den Rest des Tages' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#eaf2fb;strokeColor=#1a5fb4;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p3-1">
          <mxGeometry x="30" y="270" width="240" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="p3-i4" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;Lichtkonto&lt;/b&gt;&lt;/span&gt;&lt;br&gt;was die Pflanze heute&lt;br&gt;schon bekommen hat' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#eaf2fb;strokeColor=#1a5fb4;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p3-1">
