        <mxCell id="p3-page" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;Seite des Planers&lt;/b&gt;&lt;/span&gt;&lt;br&gt;Erlös heute gegen Nachführen' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#ffffff;strokeColor=#1f2328;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p3-1">
