        </mxCell>
        <mxCell id="p4-blabel" value='&lt;span style="font-size: 13px;"&gt;alle 3 Stunden ein neuer Plan, die nächsten 3 Stunden sind bindend&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="p4-1">
          <mxGeometry x="300" y="70" width="656" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="p4-mid" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;Um Mitternacht&lt;/b&gt;&lt;/span&gt;&lt;br&gt;Tagesbilanz: Sonnenteiler&lt;br&gt;gegen Nachführen, Pflanze&lt;br&gt;zuerst und besten Plan' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#e9f6ec;strokeColor=#1e7b34;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p4-1">
          <mxGeometry x="1010" y="70" width="210" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p4-s1" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;1 Messen&lt;/b&gt;&lt;/span&gt;&lt;br&gt;was Sonne und Wetter&lt;br&gt;bis jetzt wirklich&lt;br&gt;gebracht haben' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#eaf2fb;strokeColor=#1a5fb4;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p4-1">
          <mxGeometry x="60" y="305" width="196" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="p4-s2" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;2 Vorhersage&lt;/b&gt;&lt;/span&gt;&lt;br&gt;kleines Netz, gelernt,&lt;br&gt;korrigiert den&lt;br&gt;Wetterdienst mit dem&lt;br&gt;heute Gemessenen' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#e9f6ec;strokeColor=#1e7b34;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p4-1">
          <mxGeometry x="298" y="305" width="196" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="p4-s3" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;3 Planen&lt;/b&gt;&lt;/span&gt;&lt;br&gt;die sechs Regeln für&lt;br&gt;den Rest des Tages,&lt;br&gt;3 Stunden bindend' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#e9f6ec;strokeColor=#1e7b34;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p4-1">
          <mxGeometry x="536" y="305" width="196" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="p4-s4" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;4 Fahren&lt;/b&gt;&lt;/span&gt;&lt;br&gt;alle 5 Minuten eine neue&lt;br&gt;Pose, ein Wegdrehwinkel&lt;br&gt;pro Stunde' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#fdeeec;strokeColor=#b42318;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p4-1">
          <mxGeometry x="774" y="305" width="196" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="p4-s5" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;5 Rückblick&lt;/b&gt;&lt;/span&gt;&lt;br&gt;Block nachrechnen:&lt;br&gt;gefahren, versprochen,&lt;br&gt;bestes im Nachhinein' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#e9f6ec;strokeColor=#1e7b34;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p4-1">
          <mxGeometry x="1012" y="305" width="196" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="p4-rec" value='&lt;span style="font-size: 15px;"&gt;&lt;b&gt;Neues Rezept&lt;/b&gt;&lt;/span&gt;&lt;br&gt;vom Chatbot oder von Hand' style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#eaf2fb;strokeColor=#1a5fb4;strokeWidth=1.8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="p4-1">
          <mxGeometry x="484" y="520" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p4-sim" value="&lt;b&gt;In der Simulation&lt;/b&gt; spielt der Planer echte Tage des Datensatzes nach, 360mal so schnell:&lt;br&gt;ein Block dauert 30 s. Eine Schattenkopie fährt im selben Wetter nur der Sonne nach, zum Vergleich." style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2328;fillColor=#ffffff;strokeColor=#1f2328;strokeWidth=1.8;align=left;spacingLeft=8;verticalAlign=middle;spacing=4;" vertex="1" parent="p4-1">
